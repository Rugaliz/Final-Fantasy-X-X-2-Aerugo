#version 450
// The remaster's glow (bloom), in its effective form: a threshold pass over the scene into a full-size glow map,
// then 7-tap Gaussian blurs (0.333333; 0.190476, 0.0952381, 0.047619 at ±1, 2, 3 texels of the half-size level)
// across, down and across at half size, and a last blur down added onto the picture × gain.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform texture2D source;
layout(set = 0, binding = 1) uniform sampler linearClamp;
layout(set = 0, binding = 2, rgba8) uniform image2D target;

layout(push_constant) uniform Push {
    // Blur direction in texels of the level buffer, divided by that buffer's size.
    vec2 step;
    // Output scale of the blur passes.
    float scale;
    // Added blur: × gain onto `target` (else the blur replaces it).
    float gain;
    // Threshold pass: no-glow (lower) and full-glow (upper) luminance.
    float lower;
    float upper;
    // 0 threshold, 1 blur, 2 blur added onto the target.
    float mode;
} pc;

vec4 at(vec2 uv) {
    return textureLod(sampler2D(source, linearClamp), uv, 0.0);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(target);
    if (p.x >= size.x || p.y >= size.y) {
        return;
    }
    vec2 uv = (vec2(p) + 0.5) / vec2(size);
    if (pc.mode < 0.5) {
        vec3 c = at(uv).rgb;
        float lum = dot(c, vec3(0.3, 0.5, 0.2));
        float span = pc.upper - pc.lower;
        float x = span > 0.0 ? clamp((lum - min(pc.upper, pc.lower)) / span, 0.0, 1.0) : 1.0;
        float m = max(max(c.r, c.g), c.b);
        // The colour at its full brightness, × the glow share (black stays black).
        vec3 g = m > 0.0 ? clamp(x * c / m, 0.0, 1.0) : vec3(0.0);
        imageStore(target, p, vec4(g, 1.0));
        return;
    }
    vec2 s = pc.step;
    vec4 b = at(uv) * 0.333333 + (at(uv + s) + at(uv - s)) * 0.190476 + (at(uv + 2.0 * s) + at(uv - 2.0 * s)) * 0.0952381
           + (at(uv + 3.0 * s) + at(uv - 3.0 * s)) * 0.047619;
    b *= pc.scale;
    if (pc.mode > 1.5) {
        vec4 c = imageLoad(target, p);
        imageStore(target, p, vec4(c.rgb + b.rgb * pc.gain, c.a));
    } else {
        imageStore(target, p, b);
    }
}
