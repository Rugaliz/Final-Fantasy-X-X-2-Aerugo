#version 450
// The remaster's colour correction, in place: each channel of the finished scene is looked up in the map's
// 256-entry table (that channel of the table), and alpha becomes 1.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba8) uniform image2D target;
layout(set = 0, binding = 1) uniform texture2D table;
layout(set = 0, binding = 2) uniform sampler tableSampler;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(target);
    if (p.x >= size.x || p.y >= size.y) {
        return;
    }
    vec3 c = clamp(imageLoad(target, p).rgb, 0.0, 1.0);
    float r = textureLod(sampler2D(table, tableSampler), vec2(c.r, 0.5), 0.0).r;
    float g = textureLod(sampler2D(table, tableSampler), vec2(c.g, 0.5), 0.0).g;
    float b = textureLod(sampler2D(table, tableSampler), vec2(c.b, 0.5), 0.0).b;
    imageStore(target, p, vec4(r, g, b, 1.0));
}
